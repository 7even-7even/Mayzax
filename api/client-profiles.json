{
    "apis": [
        {
            "api-name": "get-profiles",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/profiles?page=1&pageSize=24&sortBy=createdAt&sortOrder=desc",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-profiles-count",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/profiles/count",
