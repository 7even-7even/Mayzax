{
    "apis": [
        {
            "api-name": "create-application",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/applications",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "body": {
                "profileId": "{{profileId}}",
                "applicationCompleted": true,
                "companyName": "Test Company",
                "jobLink": "https://example.com/jobs/test-job",
                "jobPortal": "OTHER",
                "jobTitle": "Software Engineer",
                "verificationMethod": null,
                "verified": false
            }
        },
        {
            "api-name": "get-applications",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "query": {
                "page": 1,
                "limit": 10,
                "jobPortal": "OTHER"
            }
        },
        {
            "api-name": "get-application",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/{{applicationId}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "update-application",
            "method": "PUT",
            "url": "http://localhost:4000/api/v1/applications/{{applicationId}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "body": {
                "applicationCompleted": false,
                "companyName": "Updated Company",
                "jobLink": "https://example.com/jobs/updated-job",
                "jobPortal": "LINKEDIN",
                "jobTitle": "Senior Software Engineer",
                "verificationMethod": "EMAIL",
                "verified": true
            }
        },
        {
            "api-name": "delete-application",
            "method": "DELETE",
            "url": "http://localhost:4000/api/v1/applications/{{applicationId}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "search-applications",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/search",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "query": {
                "q": "Software",
                "page": 1,
                "limit": 10
            }
        },
        {
            "api-name": "get-application-count",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/count",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "query": {
                "jobPortal": "LINKEDIN"
            }
        },
        {
            "api-name": "get-application-by-profile",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/profile/{{profileId}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-application-stats",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/stats",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "query": {
                "period": "month"
            }
        },
        {
            "api-name": "get-application-details",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/{{applicationId}}/details",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-applications-dashboard",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/dashboard",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "search-applications-count",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/search/count",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "query": {
                "q": "Software"
            }
        },
        {
            "api-name": "get-all-applications-stats",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/applications/stats/all",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        }
    ]   
}