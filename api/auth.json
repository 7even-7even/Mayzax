{
    "apis": [
        {
            "api-name": "login",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/login",
            "body": {
                "email": "[EMAIL_ADDRESS]",
                "password": "[PASSWORD]"
            }
        },
        {
            "api-name": "refresh",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/refresh",
            "body": {
                "refreshToken": "{{login.body.refreshToken}}"
            }
        },
        {
            "api-name": "signup",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/signup",
            "body": {
                "name": "[NAME]",
                "email": "[EMAIL_ADDRESS]",
                "password": "[PASSWORD]"
            }
        },
        {
            "api-name": "logout",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/logout",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-security-question",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/forgot-password/question",
            "body": {
                "email": "[EMAIL_ADDRESS]"
            }
        },
        {
            "api-name": "verify-security-answer",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/forgot-password/verify",
            "body": {
                "email": "[EMAIL_ADDRESS]",
                "questionId": "{{get-security-question.body.questionId}}",
                "answer": "{{get-security-question.body.answer}}"
            }
        },
        {
            "api-name": "reset-password",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/forgot-password/reset",
            "body": {
                "email": "[EMAIL_ADDRESS]",
                "questionId": "{{get-security-question.body.questionId}}",
                "answer": "{{get-security-question.body.answer}}",
                "password": "[PASSWORD]"
            }
        },
        {
            "api-name": "get-user",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/auth/user",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "set-security-question",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/auth/set-security-question",
            "body": {
                "questionId": "{{get-security-question.body.questionId}}",
                "answer": "{{get-security-question.body.answer}}"
            },
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-security-questions",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/auth/security-questions",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        }
    ]
}