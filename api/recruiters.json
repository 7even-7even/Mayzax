{
    "apis": [
        {
            "api-name": "get-recruiters",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters?page=1&pageSize=12&sortBy=createdAt&sortOrder=desc",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-recruiter-by-id",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/{{get-recruiters.response.body.data[0]._id}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-team-leaders",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters?role=TEAM_LEADER&page=1&pageSize=100",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-team-leader-by-id",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/{{get-team-leaders.response.body.data[0]._id}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-all-roles",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/roles",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-roles-count",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/roles/count",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "search-recruiters",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/search?query=john",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "filter-recruiters",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/filter?role=TEAM_LEADER",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-roles-count",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/recruiters/roles/count",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "add-recruiter",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/recruiters/add-recruiter",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "body": {
                "name": "John Doe",
                "email": "john.doe@example.com",
                "role": "RECRUITER",
                "teamLeaderId": null
            }
        },
        {
            "api-name": "create-recruiter",
            "method": "POST",
            "url": "http://localhost:4000/api/v1/recruiters",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "body": {
                "name": "John Doe",
                "email": "john.doe@example.com",
                "role": "RECRUITER",
                "teamLeaderId": null
            }
        },
        {
            "api-name": "update-recruiter",
            "method": "PATCH",
            "url": "http://localhost:4000/api/v1/recruiters/{{get-recruiters.response.body.data[0]._id}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            },
            "body": {
                "name": "John Doe",
                "email": "john.doe@example.com",
                "role": "RECRUITER",
                "teamLeaderId": null
            }
        },
        {
            "api-name": "delete-recruiter",
            "method": "DELETE",
            "url": "http://localhost:4000/api/v1/recruiters/{{recruiterId}}",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        }
    ]
}