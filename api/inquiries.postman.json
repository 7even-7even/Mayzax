{
  "info": {
    "_postman_id": "b72f8c5b-21d3-4a18-b2a6-inquiries",
    "name": "Mayzax - Candidate Enquiries",
    "description": "Postman collection for the Candidate Enquiries module. All endpoints require Admin authentication. Set {{baseUrl}} to the API base URL and {{accessToken}} to a valid JWT access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "inquiryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List Candidate Enquiries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inquiries?page=1&pageSize=10&search=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inquiries"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "10"
            },
            {
              "key": "search",
              "value": ""
            }
          ]
        },
        "description": "Admin endpoint to retrieve a paginated list of candidate enquiries, optionally filtered by search text matching name, email, or service."
      }
    },
    {
      "name": "Get Candidate Enquiry by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inquiries/{{inquiryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inquiries",
            "{{inquiryId}}"
          ]
        },
        "description": "Admin endpoint to retrieve the details of a specific candidate enquiry by ID."
      }
    }
  ]
}
