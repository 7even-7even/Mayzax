                "key": "X-Device-Name",
                "value": "{{deviceName}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Recruiter\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Creates a recruiter account and returns access token. Exact required fields depend on signupSchema."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const data = json?.data;",
                  "    if (data?.tokens?.accessToken) pm.collectionVariables.set('accessToken', data.tokens.accessToken);",
                  "    if (data?.user?.id) pm.collectionVariables.set('userId', data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
