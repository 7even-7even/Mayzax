{
    "apis": [
        {
            "api-name": "get-analytics",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/analytics",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-analytics-by-date",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/analytics/daily-counts?from={{login.body.token}}&to=2026-08-11",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-analytics-by-date-recruiter",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/analytics/daily-counts?recruiterId={{login.body.token}}&from={{login.body.token}}&to=2026-08-11",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        },
        {
            "api-name": "get-analytics-by-date-team",
            "method": "GET",
            "url": "http://localhost:4000/api/v1/analytics/daily-counts?teamId={{login.body.token}}&from={{login.body.token}}&to=2026-08-11",
            "header": {
                "Authorization": "{{login.body.token}}"
            }
        }
    ]
}