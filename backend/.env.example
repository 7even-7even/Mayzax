# =========================================================
# Mayzax ATS - Backend Environment Variables
# Copy this file to .env and fill in real values before running.
# =========================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
# Comma-separated list of extra allowed browser origins, e.g. Vercel preview URLs
ADDITIONAL_CORS_ORIGINS=

# --- Database (PostgreSQL) ---
DATABASE_URL=database_pooler_string_here
DIRECT_URL=database_direct_string_here
# --- JWT Auth ---
# Use long, random, distinct secrets in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Set to true when frontend is on Vercel and backend is on Render
CROSS_SITE_COOKIES=false

# --- Business Shift (IST) ---
BUSINESS_SHIFT_START_HOUR=19
BUSINESS_SHIFT_START_MINUTE=30
BUSINESS_SHIFT_END_HOUR=7
BUSINESS_SHIFT_END_MINUTE=30
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Enterprise Verification v2 ---
VERIFICATION_HMAC_SECRET=change_this_to_long_random_secret_min_32_chars_in_production
REQUIRE_HASH_FOR_VERIFIED=false
MIN_EXTENSION_VERSION=2.0.0
VERIFICATION_TIMESTAMP_TOLERANCE_MS=300000
VERIFICATION_HASH_TTL_MS=86400000

# --- Default Shift Policy (mobile dashboard uses these unless a ShiftConfig override exists) ---
DEFAULT_SHORT_BREAK_SECONDS=1800
DEFAULT_DINNER_BREAK_SECONDS=3600
DEFAULT_BRIEFING_SECONDS=900
DEFAULT_MEETING_SECONDS=1800
DEFAULT_SHIFT_DURATION_SECONDS=32400
DEFAULT_LATE_GRACE_MINUTES=15
DEFAULT_EARLY_GRACE_MINUTES=15
DEFAULT_PENALTY_PER_LATE_MINUTE=0

# --- Redis / BullMQ (optional - falls back to node-cron in-process if missing) ---
REDIS_URL=redis://localhost:6379

# --- Firebase Cloud Messaging (optional - push disabled if not set) ---
# Option A: raw JSON or base64-encoded service account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: absolute or cwd-relative path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# --- Logging ---
LOG_LEVEL=info
LOGS_DIR=logs

# --- Seed (used only by prisma/seed.ts) ---
SEED_ADMIN_EMAIL=admin@mayzaxsolutions.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Mayzax Admin

# Set to "true" (or pass inline, e.g. `SEED_DEMO_DATA=true npm run seed`) to also
# generate 5 recruiters, 10 client profiles, 50 job applications, and matching
# audit logs for local development / QA. NEVER enable this in production.
SEED_DEMO_DATA=false
