// =========================================================
// Mayzax ATS - Prisma Schema
// PostgreSQL database schema for the Recruitment ATS platform
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------

enum Role {
  ADMIN
  TEAM_LEADER
  RECRUITER
  RESUME_ASSIST
  SALES_EXEC
  CLIENT
}

enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum UserStatus {
  ACTIVE
  SHORT_BREAK
  DINNER_BREAK
  BRIEFING_TRAINING
  MEETING
  SYSTEM_ISSUE
  OFFLINE
}

enum JobPortal {
  LINKEDIN
  INDEED
  GLASSDOOR
  JOBRIGHT
  SIMPLIFY
  SIMPLYHIRED
  WELLFOUND
  HANDSHAKE
  NAUKRI
  DICE
  MONSTER
  ZIPRECRUITER
  COMPANY_WEBSITE
  CAREERBUILDER
  LEVER
  GREENHOUSE
  SPEEDY_APPLY
  THE_MUSE
  Y_COMBINATOR
  CAREER_SITE
  OTHER
  // v1.1 Universal ATS Intelligence
  RECRUITEE
  ASHBY
  TEAMTAILOR
  SMARTRECRUITERS
  BAMBOOHR
  JOBVITE
  PERSONIO
  TALEO
  SUCCESSFACTORS
  ICIMS
  JAZZHR
  BREEZYHR
  COMEET
  FOUNTAIN
  PINPOINT
  RIPPLING
  WORKABLE
  WORKDAY
  ORACLE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  BREAK_5MIN
  BREAK_2MIN
  BREAK_EXPIRED
  SHIFT_ENDING_15MIN
  SHIFT_ENDING_5MIN
  SHIFT_START_REMINDER
  ATTENDANCE_REMINDER
  COMPANY_NOTICE
  SYSTEM
  PENALTY_NOTICE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WEEK_OFF
  HOLIDAY
  LEAVE
  NOT_STARTED
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientType {
  WEB
  MOBILE
}

// ---------------------------------------------------------
// User (Admin / Recruiter)
// ---------------------------------------------------------

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               Role     @default(RECRUITER)
  securityQuestion   String?
  securityAnswerHash String?

  isActive  Boolean   @default(true)
  deletedAt DateTime? // soft delete

  lastActiveAt    DateTime?
  lastHeartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // If a recruiter, who created / manages them (admin)
  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  // Explicit reporting manager (falls back to createdBy if unset)
  reportingManagerId String?
  reportingManager   User?   @relation("UserReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      User[]  @relation("UserReportingManager")

  // Team name — only used by TEAM_LEADER role
  teamName String?

  // Shift configuration (optional per-user override; uses default ShiftConfig if null)
  shiftConfigId String?
  shiftConfig   ShiftConfig? @relation("UserShiftConfig", fields: [shiftConfigId], references: [id], onDelete: SetNull)

  // --- profile enrichments (nullable, safe for existing data) ---
  avatarUrl   String?  // CDN URL for avatar image
  bio         String?  @db.Text // short bio / about
  department  String?  // e.g. Engineering, Sales, HR
  location    String?  // e.g. Pune, Remote
  designation String?  // e.g. Senior Recruiter, TL - Talent Acquisition
  employeeId  String?  @unique // optional company employee code
  joinDate    DateTime? // date of joining
  shiftPreference String? // e.g. NIGHT, FLEXI
  skills      String[] @default([]) // array of skill tags
  linkedInUrl String?
  displayColor String? // hex for avatar fallback background

  // Recruiter relations
  assignedProfiles ClientProfile[]  @relation("AssignedRecruiter")
  assignedResumeAssistProfiles ClientProfile[] @relation("AssignedResumeAssist")
  profileAssignments ClientProfileAssignment[] @relation("RecruiterProfileAssignments")
  applications     JobApplication[] @relation("RecruiterApplications")
  verificationLogs VerificationLog[] @relation("RecruiterVerificationLogs")
  verificationSessions VerificationSession[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  attendanceDays   AttendanceDay[]
  auditLogs        AuditLog[]
  activityLogs     ActivityLog[]
  createdUpdates   SystemUpdate[] @relation("UserCreatedUpdates")
  updateReadLogs   UserUpdateRead[]
  approvedOnboardings ClientOnboarding[] @relation("ApprovedOnboardings")
  profileChangeRequests ClientProfileChangeRequest[] @relation("ProfileChangeRequester")
  reviewedChangeRequests ClientProfileChangeRequest[] @relation("ProfileChangeReviewer")

  clientProfileId String?          @unique
  clientProfile   ClientProfile?   @relation("ClientUser", fields: [clientProfileId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([isActive])
  @@index([department])
  @@map("users")
}

// ---------------------------------------------------------
// Shift Configuration (named shifts; one default per system)
// ---------------------------------------------------------

model ShiftConfig {
  id          String   @id @default(uuid())
  name        String   // e.g. "Night Shift IST", "US Shift"
  isDefault   Boolean  @default(false)
  timezone    String   @default("Asia/Kolkata")

  startHour   Int      @default(18)
  startMinute Int      @default(0)
  endHour     Int      @default(9)
  endMinute   Int      @default(0)

  // Allowed break durations in seconds
  shortBreakAllowedSec    Int @default(900)  // 30 min
  dinnerBreakAllowedSec   Int @default(2400)  // 60 min
  briefingAllowedSec      Int @default(900)   // 15 min
  meetingAllowedSec       Int @default(900)  // 30 min
  systemIssueAllowedSec   Int @default(0)     // unlimited by default
  expectedWorkSeconds     Int @default(28800) // 9 hours (productive + meeting)
  lateGraceMinutes        Int @default(15)
  earlyGraceMinutes       Int @default(15)
  penaltyPerLateMinute    Float @default(0)

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users      User[]   @relation("UserShiftConfig")

  @@map("shift_configs")
}

// ---------------------------------------------------------
// Device Tokens (FCM / Expo push registration)
// ---------------------------------------------------------

model DeviceToken {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  fcmToken    String         @unique // FCM / Expo push token
  platform    DevicePlatform
  deviceName  String?
  deviceModel String?
  appVersion  String?
  osVersion   String?
  pushToken   String?        // Expo push token (if applicable)

  lastSeen    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([platform])
  @@map("device_tokens")
}

// ---------------------------------------------------------
// Notifications (in-app + push fan-out)
// ---------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  data      Json?            // screen, targetId, etc.
  priority  Int              @default(0)

  readAt    DateTime?
  pushSentAt DateTime?
  pushError String?          @db.Text

  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// ---------------------------------------------------------
// Attendance Day — materialized daily rollup (server-computed)
// ---------------------------------------------------------

model AttendanceDay {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessDate    DateTime         @db.Date

  firstLoginAt    DateTime?
  lastLogoutAt    DateTime?

  totalLoggedInSec  Int @default(0)
  totalProductiveSec Int @default(0)
  totalBreakSec     Int @default(0)
  shortBreakSec     Int @default(0)
  dinnerBreakSec    Int @default(0)
  briefingSec       Int @default(0)
  meetingSec        Int @default(0)
  systemIssueSec    Int @default(0)
  onlineSec         Int @default(0)

  lateByMinutes     Int @default(0)
  earlyByMinutes    Int @default(0)
  penaltyMinutes    Int @default(0)
  expectedLogoutAt  DateTime?
  remarks           String?
  status            AttendanceStatus @default(NOT_STARTED)

  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, businessDate])
  @@index([userId, businessDate])
  @@index([businessDate])
  @@map("attendance_days")
}

// ---------------------------------------------------------
// Activity Log (Employee Activity & Shift Tracking)
// ---------------------------------------------------------

model ActivityLog {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       UserStatus
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  optionalNote String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@index([status])
  @@index([userId, endedAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------
// Revoked Access Tokens (Blacklist on logout)
// ---------------------------------------------------------

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}

// ---------------------------------------------------------
// Client Profile (Candidate profile managed by recruiters)
// ---------------------------------------------------------

model ClientProfile {
  id             String  @id @default(uuid())
  candidateName  String
  email          String
  phone          String
  technology     String
  notes          String?

  // Systematic onboarding fields
  dateOfBirth       String?
  gender            String?
  visaStatus        String?
  entryToUS         String?
  currentLocation   String?
  education         Json?
  addressHistory    Json?
  hasExperience     Boolean?          @default(false)
  experienceDetails String?           @db.Text
  certifications    String?           @db.Text
  resumeUrl         String?
  resumeFileName    String?
  planSelected      String?
  amountPaid        Float?
  paymentRef        String?
  skills            String?

  assignedRecruiterId String?
  assignedRecruiter   User?   @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  assignedResumeAssistId String?
  assignedResumeAssist   User?   @relation("AssignedResumeAssist", fields: [assignedResumeAssistId], references: [id], onDelete: SetNull)
  assignedRecruiterAssignments ClientProfileAssignment[] @relation("ProfileRecruiterAssignments")

  isActive  Boolean   @default(true)
  isArchived Boolean  @default(false)
  paymentBlocked Boolean @default(false)
  mergeHistory Json?
  deletedAt DateTime? // soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications JobApplication[]
  clientUser   User?           @relation("ClientUser")
  changeRequests ClientProfileChangeRequest[]
  payments     ClientPayment[]
  interviews   Interview[]

  @@index([assignedRecruiterId])
  @@index([assignedResumeAssistId])
  @@index([technology])
  @@index([email])
  @@index([isArchived])
  @@map("client_profiles")
}

// ---------------------------------------------------------
// Client Profile Assignments (multi-recruiter checklist)
// ---------------------------------------------------------

model ClientProfileAssignment {
  profileId   String
  recruiterId String

  profile   ClientProfile @relation("ProfileRecruiterAssignments", fields: [profileId], references: [id], onDelete: Cascade)
  recruiter User          @relation("RecruiterProfileAssignments", fields: [recruiterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([profileId, recruiterId])
  @@index([recruiterId])
  @@map("client_profile_assignments")
}

// ---------------------------------------------------------
// Job Application
// ---------------------------------------------------------

model JobApplication {
  id String @id @default(uuid())

  profileId String
  profile   ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  recruiterId String
  recruiter   User   @relation("RecruiterApplications", fields: [recruiterId], references: [id], onDelete: Restrict)

  jobLink           String
  normalizedJobLink String

  companyName String
  jobTitle    String
  jobPortal   JobPortal @default(OTHER)

  status ApplicationStatus @default(APPLIED)

  appliedAt    DateTime @default(now())
  businessDate DateTime @db.Date // derived via getBusinessDate() - IST business shift date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verified           Boolean  @default(false)
  verificationMethod String?

  // Enterprise Verification v2 fields
  verificationHash       String?   @db.VarChar(128)
  verificationVersion    String?   @default("v2")
  verificationScore      Int?
  verificationConfidence String?   // LOW|MEDIUM|HIGH
  verificationEvidence   Json?     // snapshot of evidence
  verificationPortal     String?   // portal detected by verification engine
  verificationTimestamp  DateTime?
  applicationReference   String?

  // Critical duplicate-prevention constraint:
  // Same profile cannot apply to the same normalized job link twice.
  @@unique([profileId, normalizedJobLink], name: "unique_profile_joblink")
  @@index([recruiterId])
  @@index([profileId])
  @@index([businessDate])
  @@index([status])
  @@index([verificationHash])
  @@index([applicationReference])
  @@index([verificationConfidence])
  @@map("job_applications")
}

model VerificationLog {
  id                String   @id @default(uuid())
  recruiterId       String
  recruiter         User     @relation("RecruiterVerificationLogs", fields: [recruiterId], references: [id], onDelete: Cascade)
  profileId         String?
  jobLink           String
  normalizedJobLink String
  evidence          Json
  canonicalEvidence String?  @db.Text
  verificationHash  String   @unique
  score             Int
  confidence        String   // LOW|MEDIUM|HIGH
  portal            JobPortal
  hostname          String
  pathname          String
  reference         String?
  isReplay          Boolean  @default(false)
  fraudSignals      Json?
  createdAt         DateTime @default(now())

  @@index([recruiterId])
  @@index([hostname])
  @@index([portal])
  @@index([profileId])
  @@index([createdAt])
  @@map("verification_logs")
}

// ---------------------------------------------------------
// Audit Log (engineering standard - traceability)
// ---------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    String   // e.g. "RECRUITER_CREATED", "PROFILE_UPDATED"
  entity    String   // e.g. "User", "ClientProfile", "JobApplication"
  entityId  String?
  metadata  Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// System Updates & Release Announcements
// ---------------------------------------------------------

model SystemUpdate {
  id              String   @id @default(uuid())
  title           String
  version         String?
  description     String
  pdfUrl          String?
  pdfOriginalName String?
  createdById     String
  createdBy       User     @relation("UserCreatedUpdates", fields: [createdById], references: [id], onDelete: Cascade)
  roles           Role[]   @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  readLogs UserUpdateRead[]

  @@map("system_updates")
}

model UserUpdateRead {
  id       String       @id @default(uuid())
  updateId String
  update   SystemUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime     @default(now())

  @@unique([updateId, userId])
  @@map("user_update_reads")
}

model ClientOnboarding {
  id             String           @id @default(uuid())

  // 1. Personal / Contact Info
  fullName       String
  email          String
  phone          String
  dateOfBirth    String           // DD/MM/YYYY
  gender         String           @default("")

  // 2. Educational Detail
  education      Json             // Array of qualification, fieldOfStudy, specialization, instituteName, honors, startDate, endDate, currentlyOngoing

  // 3. Technical Detail
  technology     String           // Technology track
  skills         String           // Skills list / tag string

  // 4. Visa Status Details
  visaStatus     String           // OPT, Stem OPT, H1B, CPT, etc.
  entryToUS      String?          // Month / Year (optional)
  currentLocation String

  // 5. Address Details/History (Up to 5)
  addressHistory Json             // Array of { state, country, fromDate, toDate }

  // 6. Experience Details
  hasExperience  Boolean          @default(false)
  experienceDetails String?       @db.Text

  // 7. Certifications Details
  certifications String?          @db.Text

  // 8. Resume File
  resumeUrl      String?          // Path to uploaded file
  resumeFileName String?          // Original filename

  // 9. Self Declaration / Approval
  declared       Boolean          @default(false)
  declaredAt     DateTime         @default(now())

  // 10. Payment & Plan Details (Mock)
  planSelected   String           // Basic, Premium, Gold, etc.
  amountPaid     Float
  paymentRef     String           // Mock reference code
  paidAt         DateTime         @default(now())

  // 11. Approval Workflow
  status         OnboardingStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?            @relation("ApprovedOnboardings", fields: [approvedById], references: [id], onDelete: SetNull)

  // Link to generated profile if approved
  generatedProfileId String?      @unique

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("client_onboardings")
}

// ---------------------------------------------------------
// Client Profile Change Requests (pending update approvals)
// ---------------------------------------------------------

model ClientProfileChangeRequest {
  id            String              @id @default(uuid())
  profileId     String
  profile       ClientProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User                @relation("ProfileChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  changes       Json                // Snapshot of all changed fields

  status        ChangeRequestStatus @default(PENDING)

  reviewedById  String?
  reviewedBy    User?               @relation("ProfileChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  rejectionNote String?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([profileId])
  @@index([status])
  @@map("client_profile_change_requests")
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

model ClientPayment {
  id             String        @id @default(uuid())
  profileId      String
  profile        ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount         Float
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  paymentRef     String?
  installmentNo  Int

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([profileId])
  @@map("client_payments")
}

model Interview {
  id          String   @id @default(uuid())
  profileId   String
  profile     ClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  roundName   String   // e.g. "Technical Round 1", "HR Screening"
  status      String   // e.g. "Scheduled", "Completed", "Cancelled"
  
  date        String   // e.g. "2026-08-12"
  startTime   String   // e.g. "10:30 AM"
  endTime     String   // e.g. "11:30 AM"
  timezone    String   @default("EST") // e.g. "EST", "IST"
  
  interviewer String?  // e.g. "John Doe"
  mode        String?  // e.g. "Google Meet", "Zoom", "In Person", "Phone"
  meetingLink String?  // e.g. "https://meet.google.com/..."
  notes       String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
  @@map("interviews")
}

model VerificationSession {
  id             String              @id @default(uuid())
  sessionId      String              @unique
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal         String
  jobUrl         String?             @db.Text
  jobId          String?
  applicationUrl String?             @db.Text
  applicationId  String?
  status         String              // "IN_PROGRESS" | "COMPLETED" | "ABANDONED"
  score          Int?
  scoreVersion   String?
  startedAt      DateTime            @default(now())
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  events         VerificationEvent[]

  @@index([sessionId])
  @@index([userId])
  @@index([portal])
  @@index([createdAt])
  @@map("verification_sessions")
}

model VerificationEvent {
  id        String              @id @default(uuid())
  eventId   String              @unique
  sessionId String
  session   VerificationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  type      String              // e.g., "APPLICATION_DETECTED", "APPLICATION_STARTED"
  timestamp DateTime
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([sessionId])
  @@index([eventId])
  @@index([createdAt])
  @@map("verification_events")
}

// ---------------------------------------------------------
// Website Inquiry & Hiring Partner Requests (Synced from Website project)
// ---------------------------------------------------------

model Inquiry {
  id                String   @id @default(uuid())
  fullName          String
  email             String
  phone             String?
  serviceInterested String
  details           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("inquiries")
}

model HiringPartnerRequest {
  id          String   @id @default(uuid())
  company     String
  contactName String
  workEmail   String
  phone       String?
  roleType    String
  hiresNeeded String
  details     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hiring_partner_requests")
}
