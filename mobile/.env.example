# Copy this file to .env and update values
# The API base URL for the Mayzax backend
# For Android emulators use http://10.0.2.2:4000 to reach host's localhost
# For iOS simulators use http://localhost:4000
# For physical devices use your machine's local IP, e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

EXPO_PUBLIC_APP_NAME=Mayzax Companion
EXPO_PUBLIC_SUPPORT_EMAIL=support@mayzax.example.com
EXPO_PUBLIC_SUPPORT_PHONE=+91-00000-00000
EXPO_PUBLIC_PRIVACY_URL=https://mayzax.example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://mayzax.example.com/terms
